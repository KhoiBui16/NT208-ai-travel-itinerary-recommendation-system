# ── App ──────────────────────────────────────────────
APP_NAME=DuLichViet API
APP_VERSION=2.0.0
ENVIRONMENT=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:5173

# ── Database & Redis ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dulichviet
REDIS_URL=redis://localhost:6379/0

# ── Security ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-for-local-dev

# ── AI providers (leave empty until Phase C) ────────
GEMINI_API_KEY=
GOONG_API_KEY=

# ── Email / SMTP ────────────────────────────────────
# If SMTP_HOST is empty, password reset links log to console (dev mode).
# To send real emails, fill SMTP_* and restart the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@dulichviet.local
EMAIL_FROM_NAME=DuLichViet

# ── Optional analytics ──────────────────────────────
# Keep disabled until guardrails are implemented.
ENABLE_ANALYTICS=false
ANALYTICS_DATABASE_URL=
